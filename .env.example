# Copy to .env.local. NEVER commit .env.local.
# Key is used server-side only (API route). It must never reach the client bundle.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# Optional: cap spend during eval runs
MAX_STEPS=12
MAX_TOOL_RETRIES=1

# Demo spend guards. Defaults are 5/hour per IP and 200/day globally.
# Raise temporarily (e.g. for a recording), then remove to restore defaults.
# DEMO_PER_IP_PER_HOUR=100
# DEMO_GLOBAL_PER_DAY=500
