# Copy to .env.local. NEVER commit .env.local.
# Key is used server-side only (API route). It must never reach the client bundle.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# Optional: cap spend during eval runs
MAX_STEPS=12
MAX_TOOL_RETRIES=1

# Demo spend guards. Defaults are 5/hour per IP and 200/day globally.
# Raise temporarily (e.g. for a recording), then remove to restore defaults.
# DEMO_PER_IP_PER_HOUR=100
# DEMO_GLOBAL_PER_DAY=500

# Custom URLs (optional). Off unless set. With a code of 12+ characters, opening the
# app at /?access=<code> shows a form that triages any public URL. Rate limits apply.
# CUSTOM_URL_ACCESS_CODE=

# Retrieval. Leave unset to use the shipped defaults (0.35, top 3). Choose values
# from `npm run calibrate:corpus`, then confirm with `npm run eval`.
# RETRIEVAL_THRESHOLD=0.35
# RETRIEVAL_TOP_K=3

# Tracing (optional). With both keys set, every run is traced in Langfuse.
# With either one missing, tracing is off and nothing is sent.
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_BASE_URL=   (the host shown in your Langfuse project settings; it differs by region)

# Eval cost reporting (optional). The harness carries no price table; set these
# from the provider's pricing page on the day you run it.
# PRICE_PER_1M_INPUT_USD=
# PRICE_PER_1M_OUTPUT_USD=
