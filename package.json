{
  "name": "sentinel-triage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "eval": "tsx --env-file=.env.local evals/run.ts",
    "embed:controls": "tsx --env-file=.env.local scripts/embed-controls.ts",
    "prep:labels": "tsx --env-file=.env.local evals/prep-labels.ts",
    "label": "tsx --env-file=.env.local evals/label.ts",
    "diagnose": "tsx --env-file=.env.local evals/diagnose.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.116",
    "ai": "5.0.222",
    "cheerio": "^1.0.0",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.30.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
